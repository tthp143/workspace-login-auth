# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ถูก commit)

DATABASE_URL="file:./dev.db"

# สร้างด้วย: npx auth secret
AUTH_SECRET="change-me"

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# ใช้กับ npm run db:seed (ไม่ใส่ จะได้ admin@example.com / admin1234)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
